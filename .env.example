# Copia este archivo como .env.local y rellena los datos de tu proyecto de Supabase
# (Project Settings → API). Si lo dejas vacío, la demo funciona en modo local (localStorage).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Solo para `npm run seed:users` (crea los usuarios de prueba). Nunca la expongas en el front.
SUPABASE_SERVICE_ROLE_KEY=
